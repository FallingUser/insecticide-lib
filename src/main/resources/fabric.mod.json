{
  "schemaVersion": 1,
  "id": "insecticide",
  "version": "${mod_version}",
  "name": "Insecticide",
  "description": "A mod that replaces CICADA to make it harmless",
  "authors": [
    "Tigercrl",
    "enjarai"
  ],
  "contact": {
    "sources": "https://github.com/Tigercrl/insecticide-lib",
    "issues": "https://github.com/Tigercrl/insecticide-lib/issues"
  },
  "license": "MIT",
  "icon": "assets/insecticide/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "nl.enjarai.cicada.Cicada"
    ],
    "cicada": [
      "nl.enjarai.cicada.Cicada"
    ]
  },
  "mixins": [
    "insecticide.mixins.json"
  ],
  "depends": {
    "java": ">=17",
    "minecraft": "${target_minecraft}",
    "fabricloader": ">=0.15.0"
  },
  "provides": [
    "cicada"
  ],
  "custom": {
    "modmenu": {
      "badges": [
        "library"
      ]
    },
    "loom:injected_interfaces": {
      "net/minecraft/class_243": [
        "nl/enjarai/cicada/util/duck/ConvertibleVec3d"
      ]
    }
  }
}
